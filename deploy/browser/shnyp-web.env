# shnyp im Browser – Einstellungen für die Dienste shnyp-web und shnyp-dateien.
# Nach einer Änderung: systemctl restart shnyp-web shnyp-dateien

# Bildschirmnummer und Startgröße des virtuellen Bildschirms (er passt sich danach dem
# Browserfenster an)
SHNYP_DISPLAY=:7
SHNYP_GEOMETRY=1600x1000

# Ports auf 127.0.0.1, an die der Reverse-Proxy weiterreicht
SHNYP_NOVNC_PORT=6080
SHNYP_FILES_PORT=6081

# Bibliothek, hochgeladene Fotos (der Import-Dialog öffnet sich dort) und Exporte.
# Ordner außerhalb von /srv/shnyp (nicht unter /home) müssen dem Benutzer shnyp gehören und für beide
# Dienste freigegeben werden: systemctl edit shnyp-web  und  systemctl edit shnyp-dateien, jeweils
#   [Service]
#   ReadWritePaths=/mnt/daten/Fotos
# Einfacher: die Datenplatte unter /srv/shnyp einhängen.
SHNYP_LIBRARY=/srv/shnyp/Bibliothek
SHNYP_IMPORT_DIR=/srv/shnyp/Fotos
SHNYP_EXPORTS=/srv/shnyp/Exporte

# größte hochladbare Datei in MB (ein 4K-Handyvideo hat schnell einige GB)
SHNYP_UPLOAD_MAX_MB=8192

# Ton: shnyp spielt den Ton der Video-Wiedergabe für die Seite ab (dort „🔇 Ton“ anklicken).
# SHNYP_TON=0: kein Ton (shnyp spielt dann auf die Soundkarte des Servers, falls es eine gibt).
SHNYP_TON=1

# Claude im Fenster, das du im Browser siehst: der Steuerkanal auf 127.0.0.1 (geschützt durch
# ein Token, das nur der Benutzer shnyp lesen kann, in /srv/shnyp/.config/shnyp/control.json). Für Claude
# Code auf dem Server:  claude mcp add shnyp -- sudo -u shnyp env HOME=/srv/shnyp shnyp mcp --connect
# Abschalten: SHNYP_CONTROL=0
SHNYP_CONTROL=1

# Ohne Grafikkarte: Fenster über OpenGL in Software (Mesa), Bildberechnung auf der CPU.
# Mit Grafikkarte (Vulkan): LIGHTCRAFT_GPU=1; für Intel/AMD  apt install mesa-vulkan-drivers;
# dann  systemctl edit shnyp-web  mit
#   [Service]
#   PrivateDevices=no
#   SupplementaryGroups=render video
# (eine solche Ergänzung übersteht Updates durch install.sh).
SHNYP_RENDERER=gl
LIGHTCRAFT_GPU=0
