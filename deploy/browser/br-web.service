[Unit]
Description=BR im Browser (virtueller Bildschirm, BR, noVNC)
After=network.target

[Service]
Type=simple
User=br
Group=br
EnvironmentFile=/etc/br-web.env
Environment=HOME=/srv/br
WorkingDirectory=/srv/br
ExecStart=/opt/br/bin/br-web
Restart=always
RestartSec=2
# eigenes /tmp: der X-Bildschirm und der VNC-Socket sind nur in diesem Dienst sichtbar
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/srv/br

[Install]
WantedBy=multi-user.target
