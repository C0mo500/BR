# BR im Browser hinter nginx: in den server-Block mit HTTPS (z. B. von certbot) einfügen.
# Login-Datei anlegen:  htpasswd -c /etc/nginx/br.htpasswd ich   (Paket apache2-utils)
# Hier unter https://example.org/br/ – für eine eigene Subdomain überall /br/ durch / ersetzen.
# "^~": Regex-Blöcke, die im server-Block schon stehen (etwa für .js oder .jpg), greifen hier nicht.

location = /br { return 301 /br/; }

location ^~ /br/ {
    auth_basic "BR";
    auth_basic_user_file /etc/nginx/br.htpasswd;

    # die Seite, Foto-Upload und Exporte
    proxy_pass http://127.0.0.1:6081/;
    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
}

location ^~ /br/novnc/ {
    auth_basic "BR";
    auth_basic_user_file /etc/nginx/br.htpasswd;

    # Nur die eigene Seite darf die Verbindung zu BR öffnen: der Browser schickt den Login auch
    # mit, wenn eine fremde Webseite es versucht.
    set $br_origin_ok "";
    if ($http_origin = "") { set $br_origin_ok 1; }
    if ($http_origin = "$scheme://$http_host") { set $br_origin_ok 1; }
    if ($br_origin_ok = "") { return 403; }
    add_header X-Frame-Options SAMEORIGIN always;

    # noVNC und seine WebSocket-Verbindung
    proxy_pass http://127.0.0.1:6080/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 1d;
    proxy_send_timeout 1d;
}
