#!/bin/bash
# shnyp im Browser: ein virtueller Bildschirm (Xvnc) mit dem shnyp-Fenster, ein Fenster-Manager, der es
# bildschirmfüllend hält, und noVNC, das den Bildschirm über eine WebSocket-Verbindung in den
# Browser bringt. Läuft als Dienst shnyp-web (siehe shnyp-web.service); die Einstellungen kommen aus
# /etc/shnyp-web.env.
#
# Der VNC-Server hört auf keinem Netzwerk-Port, nur auf einer Unix-Socket-Datei in diesem Dienst;
# erreichbar ist shnyp allein über websockify auf 127.0.0.1 – und das gehört hinter einen
# Reverse-Proxy mit HTTPS und Login (siehe README.md). Dazu verlangt der VNC-Server ein Passwort,
# das bei jedem Start neu ausgewürfelt wird und das nur die eigene Seite abholen kann
# (shnyp-dateien, /api/vnc): eine fremde Webseite, die den Login im Browser mitbenutzt, kommt so
# nicht an shnyp heran. Ohne Sperrliste: alle Verbindungen kommen über denselben Socket, eine
# Sperre nach Fehlversuchen träfe also auch die eigene Seite; erraten lässt sich das Passwort nicht.
set -euo pipefail

: "${SHNYP_DISPLAY:=:7}"
: "${SHNYP_GEOMETRY:=1600x1000}"
: "${SHNYP_NOVNC_PORT:=6080}"
: "${SHNYP_BIN:=/opt/shnyp/bin/shnyp}"
: "${SHNYP_SHARE:=/opt/shnyp/share}"
: "${SHNYP_NOVNC_WEB:=/usr/share/novnc}"
: "${SHNYP_RUN_DIR:=${TMPDIR:-/tmp}/shnyp-web}"
: "${SHNYP_IMPORT_DIR:=$HOME}"
: "${SHNYP_VNC_PASSWORD_FILE:=$HOME/.shnyp-web/vnc-passwort}"
export SHNYP_RENDERER="${SHNYP_RENDERER:-gl}"
# der Ton der Wiedergabe für die Seite (shnyp-dateien reicht ihn als /api/ton weiter); SHNYP_TON=0: keiner
if [ "${SHNYP_TON:-1}" != 0 ]; then
    export SHNYP_AUDIO_STREAM="${SHNYP_AUDIO_STREAM:-$HOME/.shnyp-web/ton.sock}"
fi
export LIGHTCRAFT_GPU="${LIGHTCRAFT_GPU:-0}"

# Kein Desktop-Portal auf dem Server-Bildschirm: Datei-Dialoge kommen von zenity.
unset DBUS_SESSION_BUS_ADDRESS WAYLAND_DISPLAY

display_no=${SHNYP_DISPLAY#:}
mkdir -p "$SHNYP_RUN_DIR" "$SHNYP_IMPORT_DIR"
chmod 700 "$SHNYP_RUN_DIR"
vnc_socket=$SHNYP_RUN_DIR/vnc.sock
rm -f "$vnc_socket"

# das VNC-Passwort: 6 Zufallsbytes, als 8 Zeichen (so lang ist ein VNC-Passwort höchstens)
umask 077
password=$(head -c 6 /dev/urandom | base64)
printf '%s\n' "$password" | vncpasswd -f >"$SHNYP_RUN_DIR/passwd"
mkdir -p "$(dirname "$SHNYP_VNC_PASSWORD_FILE")"
printf '%s' "$password" >"$SHNYP_VNC_PASSWORD_FILE.neu"
mv -f "$SHNYP_VNC_PASSWORD_FILE.neu" "$SHNYP_VNC_PASSWORD_FILE"
unset password
umask 022

trap 'kill $(jobs -p) 2>/dev/null; wait' EXIT

Xvnc "$SHNYP_DISPLAY" -desktop shnyp -geometry "$SHNYP_GEOMETRY" -depth 24 \
    -rfbport -1 -rfbunixpath "$vnc_socket" -rfbunixmode 0600 \
    -SecurityTypes VncAuth -PasswordFile "$SHNYP_RUN_DIR/passwd" -UseBlacklist=0 \
    -AlwaysShared -nolisten tcp -nolisten local &

for _ in $(seq 100); do
    [ -S "/tmp/.X11-unix/X$display_no" ] && [ -S "$vnc_socket" ] && break
    sleep 0.1
done
if ! [ -S "/tmp/.X11-unix/X$display_no" ] || ! [ -S "$vnc_socket" ]; then
    echo "shnyp-web: der Bildschirm $SHNYP_DISPLAY ist nicht gestartet" >&2
    exit 1
fi
export DISPLAY=$SHNYP_DISPLAY

openbox --config-file "$SHNYP_SHARE/openbox-rc.xml" &

websockify --web "$SHNYP_NOVNC_WEB" --heartbeat 30 "127.0.0.1:$SHNYP_NOVNC_PORT" --unix-target "$vnc_socket" &

# shnyp selbst: nach „Beenden“ (oder einem Absturz) startet es nach einer Sekunde neu, damit die
# Seite im Browser immer etwas zeigt. Der Datei-Dialog öffnet sich im Upload-Ordner.
(
    cd "$SHNYP_IMPORT_DIR"
    while true; do
        "$SHNYP_BIN" || echo "shnyp-web: shnyp endete mit Status $?" >&2
        sleep 1
    done
) &

# Endet einer der Teile (Bildschirm, Fenster-Manager, noVNC), startet systemd den ganzen Dienst neu.
wait -n
echo "shnyp-web: ein Teil ist beendet, alles wird neu gestartet" >&2
exit 1
