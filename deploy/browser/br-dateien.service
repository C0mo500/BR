[Unit]
Description=BR im Browser: Seite, Foto-Upload und Export-Download
After=network.target

[Service]
Type=simple
User=br
Group=br
EnvironmentFile=/etc/br-web.env
ExecStart=/usr/bin/python3 /opt/br/share/br-dateien.py
Restart=always
RestartSec=2
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/br

[Install]
WantedBy=multi-user.target
