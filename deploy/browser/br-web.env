# BR im Browser – Einstellungen für die Dienste br-web und br-dateien.
# Nach einer Änderung: systemctl restart br-web br-dateien

# Bildschirmnummer und Startgröße des virtuellen Bildschirms (er passt sich danach dem
# Browserfenster an)
BR_DISPLAY=:7
BR_GEOMETRY=1600x1000

# Ports auf 127.0.0.1, an die der Reverse-Proxy weiterreicht
BR_NOVNC_PORT=6080
BR_FILES_PORT=6081

# Bibliothek, hochgeladene Fotos (der Import-Dialog öffnet sich dort) und Exporte.
# Ordner außerhalb von /srv/br (nicht unter /home) müssen dem Benutzer br gehören und für beide
# Dienste freigegeben werden: systemctl edit br-web  und  systemctl edit br-dateien, jeweils
#   [Service]
#   ReadWritePaths=/mnt/daten/Fotos
# Einfacher: die Datenplatte unter /srv/br einhängen.
BR_LIBRARY=/srv/br/Bibliothek
BR_IMPORT_DIR=/srv/br/Fotos
BR_EXPORTS=/srv/br/Exporte

# größte hochladbare Datei in MB (ein 4K-Handyvideo hat schnell einige GB)
BR_UPLOAD_MAX_MB=8192

# Ton: BR spielt den Ton der Video-Wiedergabe für die Seite ab (dort „🔇 Ton“ anklicken).
# BR_TON=0: kein Ton (BR spielt dann auf die Soundkarte des Servers, falls es eine gibt).
BR_TON=1

# Claude im Fenster, das du im Browser siehst: der Steuerkanal auf 127.0.0.1 (geschützt durch
# ein Token, das nur der Benutzer br lesen kann, in /srv/br/.config/BR/control.json). Für Claude
# Code auf dem Server:  claude mcp add br -- sudo -u br env HOME=/srv/br br mcp --connect
# Abschalten: BR_CONTROL=0
BR_CONTROL=1

# Ohne Grafikkarte: Fenster über OpenGL in Software (Mesa), Bildberechnung auf der CPU.
# Mit Grafikkarte (Vulkan): LIGHTCRAFT_GPU=1; für Intel/AMD  apt install mesa-vulkan-drivers;
# dann  systemctl edit br-web  mit
#   [Service]
#   PrivateDevices=no
#   SupplementaryGroups=render video
# (eine solche Ergänzung übersteht Updates durch install.sh).
BR_RENDERER=gl
LIGHTCRAFT_GPU=0
